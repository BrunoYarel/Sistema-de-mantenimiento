# backend/.env.example
#
# CON DOCKER (docker compose up) NO necesitas este archivo: docker-compose.yml ya define estos valores.
# Si copias este archivo a backend/.env, SUS valores ganan sobre los de docker-compose.yml.
# Usalo solo para correr PHP fuera de Docker (php -S): entonces cambia BD_HOST a localhost.
# (No pongas comentarios al final de una linea: se leerian como parte del valor.)

# local = modulo plantilla activo. En el servidor real: produccion.
APP_ENV=local
API_PREFIJO=/api

# Usuario de la aplicacion: sin DDL, sin DELETE, solo INSERT en evento (database/grants.sql)
# BD_HOST: "db" dentro de Docker (nombre del servicio en docker-compose.yml); "localhost" fuera de Docker.
BD_HOST=db
BD_PUERTO=5432
BD_NOMBRE=caso_a
BD_USUARIO=caso_a_app
BD_CLAVE=app_dev

# Dueño del esquema: solo para bin/migrar.php y bin/respaldo.php
BD_MIGRACION_USUARIO=caso_a_dueno
BD_MIGRACION_CLAVE=dueno_dev

# Sesión y login (RNF-01)
SESION_MINUTOS=480
LOGIN_MAX_FALLOS=5
LOGIN_BLOQUEO_MINUTOS=15
# 1 fuerza cookie Secure; vacío = automático según HTTPS
COOKIE_SEGURA=
# Orígenes extra permitidos para POST (separados por coma). Normalmente vacío: mismo origen.
ORIGENES_PERMITIDOS=
